# LiveKit Configuration
# IMPORTANT: Get these credentials from your LiveKit project dashboard at https://cloud.livekit.io
# Make sure the API Key and API Secret are from the SAME project and haven't been rotated
# 
# Steps to get correct credentials:
# 1. Go to https://cloud.livekit.io
# 2. Select your project (or create a new one)
# 3. Go to Settings > Keys
# 4. Copy the API Key (starts with "API") and API Secret (long alphanumeric string)
# 5. Make sure both are from the same project and are currently active
LIVEKIT_URL=wss://your-project-name.livekit.cloud
LIVEKIT_API_KEY=your-api-key-here
LIVEKIT_API_SECRET=your-api-secret-here

# Client-side LiveKit URL (exposed to browser) - should match LIVEKIT_URL above
VITE_LIVEKIT_WS_URL=wss://your-project-name.livekit.cloud

# Deepgram Configuration
# Get your API key from https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key

# Gemini Configuration  
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key